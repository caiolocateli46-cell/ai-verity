# ─────────────────────────────────────────────────────────
#  AI VERITY — Variáveis de Ambiente
#  Copie este arquivo para .env e preencha com seus valores
#  NUNCA commite o .env com chaves reais!
# ─────────────────────────────────────────────────────────

# Chave de API do Groq (obtenha em https://console.groq.com)
VITE_GROQ_API_KEY=your_groq_api_key_here

# Modelo padrão (pode ser trocado na interface)
VITE_GROQ_MODEL=llama-3.3-70b-versatile

# Informações do app
VITE_APP_NAME=AI VERITY
VITE_APP_VERSION=4.2.0
